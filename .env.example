# =============================================================================
# SmartScan — credential template
#
# COPY THIS FILE, DO NOT EDIT IT:
#     cp .env.example .env
#
# `.env.example` is committed (it contains no secrets). `.env` is in
# .gitignore and must never be committed, pasted into a chat, or printed in a
# notebook cell. If a token is ever exposed: ROTATE IT FIRST, then scrub. A
# secret that has been exposed is compromised even after it is deleted.
#
# Nothing here is required to run SmartScan. The simulator, all nine
# schedulers, the benchmark and the tests work with no credentials at all —
# the dataset regenerates from seeds when Kaggle is unreachable.
# =============================================================================

# -----------------------------------------------------------------------------
# Kaggle — needed only to PUBLISH or DOWNLOAD the dataset.
#
# Get these from kaggle.com -> Settings -> API -> "Create New Token". That
# downloads a kaggle.json containing {"username": "...", "key": "..."}.
# Copy the two values across.
#
# Kaggle CLI 2.x accepts SEVERAL mechanisms; any one is enough:
#
#   a) kaggle auth login                        OAuth, nothing to store  (simplest)
#   b) KAGGLE_API_TOKEN=KGAT_...                single token, env var
#   c) echo KGAT_... > ~/.kaggle/access_token   single token, file
#   d) KAGGLE_USERNAME + KAGGLE_KEY             legacy pair, below
#
# Use (d) if you also want `kagglehub` downloads, which still expect the pair.
# Set KAGGLE_USERNAME regardless: the dataset slug is <username>/<name>.
# -----------------------------------------------------------------------------
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=0000000000000000000000000000000000

# Alternative to the pair above (CLI 2.x only):
# KAGGLE_API_TOKEN=KGAT_your_token_here

# Dataset slugs. The owner is taken from KAGGLE_USERNAME.
SMARTSCAN_DATASET_SLUG=ew-smart-scan-rf-environment
SMARTSCAN_MODELS_SLUG=ew-smart-scan-models

# -----------------------------------------------------------------------------
# Hugging Face — needed only for the GATED Turing Synthetic Radar Dataset.
#
# 1. Request access: https://huggingface.co/datasets/alan-turing-institute/turing-synthetic-radar-dataset
# 2. Wait for the grant (per-user, not instant)
# 3. Create a READ token at https://huggingface.co/settings/tokens
#
# SmartScan never mirrors or redistributes this dataset. Without a token the
# external-validation report degrades gracefully and says why.
# -----------------------------------------------------------------------------
HF_TOKEN=hf_your_read_token_here

# -----------------------------------------------------------------------------
# Local paths — optional overrides.
# -----------------------------------------------------------------------------
# Use an already-built dataset instead of downloading:
# SMARTSCAN_DATA=build/dataset

# Where downloads are cached (default: ~/.cache/smartscan):
# SMARTSCAN_CACHE=

# -----------------------------------------------------------------------------
# Determinism — pinned, not auto-detected. CPU reduction order varies with
# thread count, so a fixed value keeps results identical across machines.
# -----------------------------------------------------------------------------
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
